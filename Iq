local function StealItem(itemName)
    local lplayer = Players.LocalPlayer
    local char = lplayer.Character or lplayer.CharacterAdded:Wait()
    local targetTool = nil
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= lplayer then
            if player.Character then
                targetTool = player.Character:FindFirstChild(itemName)
            end
            if not targetTool and player:FindFirstChild("Backpack") then
                targetTool = player.Backpack:FindFirstChild(itemName)
            end
            if targetTool then break end
        end
    end

    if targetTool then
        local handle = targetTool:FindFirstChild("Handle") or targetTool:FindFirstChildWhichIsA("BasePart")
        local arm = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
        
        if handle and arm then
            targetTool.Parent = char
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = arm
            weld.Part1 = handle
            weld.Parent = handle
            Notify("Steal " .. itemName, "Successfully stole " .. itemName .. " and welded to character!", 5)
        else
            targetTool.Parent = lplayer:WaitForChild("Backpack")
            Notify("Steal " .. itemName, "Stole " .. itemName .. " to Backpack!", 5)
        end
    else
        Notify("Steal " .. itemName, "No player currently has '" .. itemName .. "' equipped or in Backpack.", 5)
    end
end

