-- Orbit System Setup
local ActiveOrbitConnection = nil

local function EquipAndOrbit(itemList, radius, speed)
    if ActiveOrbitConnection then
        ActiveOrbitConnection:Disconnect()
        ActiveOrbitConnection = nil
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local bp = LocalPlayer:WaitForChild("Backpack")
    local toolsToOrbit = {}

    for _, itemName in ipairs(itemList) do
        PurchaseItem(itemName)
        task.wait(0.25)
        local tool = bp:FindFirstChild(itemName) or char:FindFirstChild(itemName)
        if tool and tool:IsA("Tool") then
            tool.Parent = char
            table.insert(toolsToOrbit, tool)
        end
    end

    local angle = 0
    local numTools = #toolsToOrbit

    if numTools > 0 then
        ActiveOrbitConnection = RunService.RenderStepped:Connect(function(dt)
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            angle = angle + (dt * speed)

            for i, tool in ipairs(toolsToOrbit) do
                if tool and tool.Parent == char then
                    local offsetAngle = angle + ((i - 1) * (math.pi * 2 / numTools))
                    local x = math.cos(offsetAngle) * radius
                    local z = math.sin(offsetAngle) * radius
                    
                    tool.Grip = CFrame.new(x, 0, z)
                    tool.GripPos = Vector3.new(x, 0, z)
                end
            end
        end)
        Notify("Orbit System", "Orbiting " .. tostring(numTools) .. " items around player!", 5)
    end
end

local function EquipAndGrip(itemList, notifyTitle)
    if ActiveOrbitConnection then
        ActiveOrbitConnection:Disconnect()
        ActiveOrbitConnection = nil
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local bp = LocalPlayer:WaitForChild("Backpack")
    for _, item in ipairs(itemList) do
        PurchaseItem(item.name)
        task.wait(0.25)
        local tool = bp:FindFirstChild(item.name) or char:FindFirstChild(item.name)
        if tool and tool:IsA("Tool") then
            tool.Parent = char
            task.wait(0.05)
            tool.Grip = CFrame.new(item.pos.X, item.pos.Y, item.pos.Z) * CFrame.Angles(math.rad(item.rot.X), math.rad(item.rot.Y), math.rad(item.rot.Z))
            tool.GripPos = item.pos
        end
    end
    Notify(notifyTitle, "Equipped & Aligned!", 5)
end

