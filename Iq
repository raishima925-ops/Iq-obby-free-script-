    if remote then
        pcall(function() remote:InvokeServer(name, 149827570) end)
    end
end

-- Helper: Visual Spawn Item to Backpack & Workspace
local function SpawnVisualItem(itemName)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")
    local backpack = LocalPlayer:WaitForChild("Backpack")

    local foundTool = nil
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("Tool") and (obj.Name:lower() == itemName:lower() or obj.Name:lower():find(itemName:lower())) then
            foundTool = obj
            break
        end
    end

    if foundTool then
        local invClone = foundTool:Clone()
        invClone.Parent = backpack

        local wsClone = foundTool:Clone()
        if root then
            wsClone:PivotTo(root.CFrame * CFrame.new(0, 0, -5))
        end
        wsClone.Parent = workspace
        Notify("Spawn Success", "Spawned '" .. foundTool.Name .. "' to Inventory & Workspace!", 4)
    else
        Notify("Spawn Error", "Tool model for '" .. itemName .. "' not found.", 4)
    end
end

